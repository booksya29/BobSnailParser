@echo off
setlocal enabledelayedexpansion
chcp 65001 > nul
title Збірка BobSnailParser

:: Завжди переходимо в папку проекту
cd /d "%~dp0"

echo ===================================================
echo        BobSnailParser - Автоматична збірка         
echo ===================================================
echo.

:: Перевірка наявності Python у системі
where python >nul 2>nul
if %errorlevel% neq 0 (
    echo [ПОМИЛКА] Python не знайдено в змінній PATH!
    echo Будь ласка, переконайтеся, що Python встановлено і додано в PATH.
    echo.
    pause
    exit /b 1
)

echo [1/1] Початок компіляції та створення архіву...
echo.

python build.py

if %errorlevel% neq 0 (
    echo.
    echo ===================================================
    echo  [ПОМИЛКА] Збірка завершилася з помилкою!
    echo ===================================================
) else (
    echo.
    echo ===================================================
    echo  [УСПІХ] Програму успішно скомпільовано!
    echo  Архів з останньою версією розміщено на робочому столі.
    echo ===================================================
)

echo.
pause

